generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ESTUDIANTE
  DOCENTE
  ADMIN
}

model Usuario {
  id         Int         @id @default(autoincrement())
  usuario    String      @unique
  nombre     String
  apellido   String
  correo     String      @unique
  clave      String
  colegio    String?
  rol        Rol         @default(ESTUDIANTE)
  creadoEn   DateTime    @default(now())
  respuestas Respuesta[]
  debeCambiarClave Boolean @default(false)
  avatarIcono     String?
  avatarColor     String  @default("azul")
  ocultoEnRanking Boolean @default(false)
  reportes        ReportePregunta[]

}

model Area {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  preguntas Pregunta[]
  delDia    PreguntaDelDia[]
}

model Pregunta {
  id          Int              @id @default(autoincrement())
  enunciado   String
  explicacion String
  areaId      Int
  area        Area             @relation(fields: [areaId], references: [id])
  opciones    Opcion[]
  respuestas  Respuesta[]
  delDia      PreguntaDelDia[]
  reportes    ReportePregunta[]
}

model Opcion {
  id         Int      @id @default(autoincrement())
  texto      String
  esCorrecta Boolean  @default(false)
  preguntaId Int
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id])
}

model Respuesta {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  preguntaId Int
  opcionId   Int
  acierto    Boolean
  puntaje    Int
  fecha      DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id])

  @@unique([usuarioId, preguntaId])
}

model IntentoLogin {
  id      Int      @id @default(autoincrement())
  usuario String
  ip      String
  fecha   DateTime @default(now())

  @@index([usuario, fecha])
  @@index([ip, fecha])
}

model PreguntaDelDia {
  fecha      DateTime @db.Date
  areaId     Int
  preguntaId Int
  area       Area     @relation(fields: [areaId], references: [id])
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id])

  @@id([fecha, areaId])
}

enum MotivoReporte {
  RESPUESTA_INCORRECTA
  ENUNCIADO_CONFUSO
  ERROR_DE_TEXTO
  OTRO
}

enum EstadoReporte {
  PENDIENTE
  RESUELTO
  DESCARTADO
}

model ReportePregunta {
  id         Int           @id @default(autoincrement())
  preguntaId Int
  usuarioId  Int
  motivo     MotivoReporte
  comentario String?
  estado     EstadoReporte @default(PENDIENTE)
  fecha      DateTime      @default(now())
  pregunta   Pregunta      @relation(fields: [preguntaId], references: [id])
  usuario    Usuario       @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, preguntaId])
  @@index([estado, fecha])
}